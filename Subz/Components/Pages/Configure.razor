@page "/configure"

<PageTitle>Subz Configuration</PageTitle>

<div id="title">
  <img src="logo.png" alt="Subz Logo. Just a text with some stripe effects" />
  <span class="subtitle">Stremio Subtitle Addon</span>
  <hr class="solid">
</div>

<OpenSubtitleCredentialsBlock @ref="credentialsBlock"/>

<SubtitleLanguageSelectionBlock @ref="languageBlock"/>

<HearingImpairmentBlock @ref="hearingImpairmentBlock"/>

<DiscordNotificationHookBlock @ref="discordNotificationHookBlock"/>

<div id="install-block">
  <h1>Install addon</h1>
  
  <div id="manifest-generate-button">
    <button class="button-17" role="button" @onclick="GenerateManifestUrlAsync" disabled="@isWaitingForConfigCheck">
      @(isWaitingForConfigCheck ? "Checking..." : "Generate manifest url")
    </button>
  </div>

  @if (!string.IsNullOrEmpty(installUrl))
  {
    <div id="install-buttons">
      @* <a href="@installUrl" target="_blank"> *@
      @*   <button class="button-17" role="button" disabled="@isWaitingForConfigCheck"> *@
      @*     @(isWaitingForConfigCheck ? "Checking..." : "Install to app") *@
      @*   </button> *@
      @* </a> *@
      @* *@
      @* <a href="@installUrl" target="_blank"> *@
      @*   <button class="button-17" role="button" disabled="@isWaitingForConfigCheck"> *@
      @*     @(isWaitingForConfigCheck ? "Checking..." : "Install to webpage") *@
      @*   </button> *@
      @* </a> *@

      <button class="button-17" role="button" disabled="@isWaitingForConfigCheck" @onclick="CopyManifestUrlToClipboard">
        @(isWaitingForConfigCheck ? "Checking..." : "Copy to clipboard")
      </button>
    </div>
  }
  
</div>

@if (!string.IsNullOrEmpty(configCheckStatusMessage))
{
  <div class="@(isThereAnErrorAtConfigCheck ? "error-message" : "success-message")">
    @configCheckStatusMessage
  </div>
}

@* todo: Unable to display scalar, this MUST be checked *@
@* <a href="/scalar" target="_blank">Api</a> *@

@code {
  private OpenSubtitleCredentialsBlock credentialsBlock;
  private SubtitleLanguageSelectionBlock languageBlock;
  private HearingImpairmentBlock hearingImpairmentBlock;
  private DiscordNotificationHookBlock discordNotificationHookBlock;

  private string configCheckStatusMessage = "";
  private bool isThereAnErrorAtConfigCheck = false;
  private bool isWaitingForConfigCheck = false;
  
  private string installUrl = "";
  private string installFromWebAppUrl = "";
  private string installFromAppUrl = "";

  private async Task GenerateManifestUrlAsync()
  {
    var windowUrl = await JSRuntime.InvokeAsync<string>("getCurrentUrlInfo");

    try
    {
      var configModel = await UserProfileFactory.CreateAsync(
        credentialsBlock,
        languageBlock,
        hearingImpairmentBlock,
        discordNotificationHookBlock,
        windowUrl);

      configCheckStatusMessage = "Success! Configuration string generated.";
      isThereAnErrorAtConfigCheck = false;

      installUrl = configModel.InstallAddonUrl;
      // installFromWebAppUrl = $"https://web.stremio.com/#/addons?addon={configModel.InstallUrl}";
      // installFromAppUrl = $"stremio://{configModel.InstallUrl}";
    }
    catch (Exception e)
    {
      configCheckStatusMessage = e.Message;
      isThereAnErrorAtConfigCheck = true;
    }
    finally
    {
      isWaitingForConfigCheck = false;
      StateHasChanged();
    }
  }

  private async Task CopyManifestUrlToClipboard()
  {
    if (!string.IsNullOrEmpty(installUrl))
    {
      await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", installUrl);
    }
  }
}

<script>
  function getCurrentUrlInfo() {
    return window.location.protocol + "//" + window.location.hostname + ":" + window.location.port;
  }
</script>
