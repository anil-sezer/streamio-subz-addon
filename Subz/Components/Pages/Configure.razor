@page "/configuration"
@using Serilog
@using Subz.OpenSubtitleClient

<PageTitle>Subz Configuration</PageTitle>

<div id="title">
  <h1>Subz</h1>
  <span class="subtitle">Stremio Subtitle Addon</span>
  <hr class="solid">
</div>

<OpenSubtitleCredentialsBlock/>

<hr class="solid">

<select id="language" class="form-select">
  @foreach (var lang in Languages.LanguageList)
  {
    <option value="@lang.LanguageCode">@lang.Flag @lang.LanguageName (@lang.Country)</option>
  }
</select>
  
<!-- todo: make it more generic. I want non eye straining code on this page. -->
<div class="radio-container">
  <label class="radio-label" for="hearingImpairment">Hearing Impairment</label>
    
  <div role="radiogroup" aria-required="false" dir="ltr" class="radio-group" id="hearingImpairment">
      
    <button type="button" role="radio" aria-checked="false" data-state="unchecked" value="hiInclude" class="radio-option">
      <div class="radio-content">
        <HearingIconSvg />
        <div class="radio-text">Include</div>
      </div>
    </button>
      
    <button type="button" role="radio" aria-checked="false" data-state="unchecked" value="hiExclude" class="radio-option">
      <div class="radio-content">
        <HearingIconSvg />
        <div class="radio-text">Exclude</div>
      </div>
    </button>
      
    <button type="button" role="radio" aria-checked="true" data-state="unchecked" value="hiOnly" class="radio-option">
      <div class="radio-content">
        <HearingIconSvg />
        <div class="radio-text">Only</div>
      </div>
    </button>
      
  </div>
</div>

<hr class="solid">

<div id="install-button-box">
  <button class="button-85" role="button">Install addon</button>
  <button class="button-17" role="button">Copy to clipboard</button>
</div>

<a href="/manifest.json" target="_blank">View Manifest</a>
<a href="/scalar" target="_blank">Api</a>

