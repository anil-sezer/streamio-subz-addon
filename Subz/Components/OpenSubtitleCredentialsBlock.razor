@using Serilog
@using Subz.Consts
@using Subz.OpenSubtitleClient
@using Subz.OpenSubtitleClient.Services

@* Textbox styles taken from here: https://codepen.io/lucasyem/pen/ZEEYKdj *@

<div id="opensubtitle-credentials" class="block">
  <div class="block-title">Your OpenSubtitle credentials</div>
  
  <div class="nice-group">
    <input type="text" class="nice-textbox" placeholder="Username" name="Username" id="os-username" @bind="Username" required/>
    <label for="os-username" class="nice-label">Username</label>
  </div>
  <span>Note: Do not use email, use your username that can be seen in your profile page.</span>
  <div class="nice-group">
    <input type="text" class="nice-textbox" placeholder="Password" name="Password" id="os-password" @bind="Password" required/>
    <label for="os-password" class="nice-label">Password</label>
  </div>

  <div class="nice-group">
    <input type="text" class="nice-textbox" placeholder="Api key" name="ApiKey" id="os-api-key" @bind="ApiKey" required/>
    <label for="os-api-key" class="nice-label">Api key</label>
  </div>
  <span>
    Not be confused by the api token. <br/>
    Api key creation guide is here: <NavLink href="@PageNameConsts.HowToCreateOpenSubtitlesApiKey">here</NavLink> <br/><br/>
    OpenSubtitles says <a href="https://www.opensubtitles.com/en/consumers" target="_blank" rel="noopener noreferrer">at here</a> if you do not perform any downloads for more than 60 days you will need to create a new api key.
    <br/>
  </span>
  
  <div class="button-to-center-container">
    <button class="button-17 check-button" role="button" @onclick="CheckCredentials" disabled="@isChecking">
      @(isChecking ? "Checking..." : "Check credentials")
    </button>
  </div>

  @if (!string.IsNullOrEmpty(statusMessage))
  {
    <div class="@(isError ? "error-message" : "success-message")">
      @statusMessage
    </div>
  }
</div>

@code {
  public string Username = "";
  public string Password = "";
  public string ApiKey = "";
  
  private string statusMessage = "";
  private bool isError = false;
  private bool isChecking = false;

  private async Task CheckCredentials()
  {
    Log.Information("Checking OpenSubtitles credentials...");
    if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(ApiKey))
    {
      statusMessage = "Please enter username, password and api key (Not api token, api key)";
      isError = true;
      return;
    }

    try
    {
      isChecking = true;
      statusMessage = "";
      
      var openSubtitlesClient = await OsClientFactory.CreateAsync(Username, Password, ApiKey);

      var response = await openSubtitlesClient.LoginAsync();

      if (!string.IsNullOrEmpty(response.Token))
      {
        statusMessage = $"Login successful! {Environment.NewLine}Remaining downloads: {response.User.AllowedDownloads}";
        isError = false;

        Log.Information("✅ Login successful. Token: {Token}", response.Token);

        // You might want to store the token or do something with it
      } 
      else
      {
        var msg = $"Login failed with {response.Status} code. Message from Opensubtitles: {response.ErrorMessage}" + 
                  (response.Status == 403 ? $"{Environment.NewLine}{Environment.NewLine}Tip from addon dev: You are probably using wrong credentials." : "");
        statusMessage = msg;
        isError = true;
        Log.Information(msg);
      }
    }
    catch (HttpRequestException ex)
    {
      statusMessage = "Login failed. Please check your credentials.";
      isError = true;
      Log.Information("❌ Login failed. Exception: {Message}", ex.Message);

    }
    catch (Exception ex)
    {
      statusMessage = "An unexpected error occurred.";
      isError = true;
      Log.Information("❌ Login failed. Exception: {Message}", ex.Message);
    }
    finally
    {
      isChecking = false;
      StateHasChanged();
    }
  }
}