<div id="subtitle-language-select-block" class="block">
    <div class="block-title">Select Languages</div>
    <div id="selectedValues" class="selected-values">No language selected</div>

    <div class="button-to-center-container">
        <button id="langSelectDropdownBtn">Click here to select</button>
    </div>

    <div class="dropdown-menu nice-buttons" id="langSelectDropdownMenu">
        @foreach (var lang in Languages.LanguageList)
        {
            <label><input type="checkbox" value="1"> @lang.Flag @lang.LanguageName</label>
        }
    </div>
</div>

@code {
    private IJSObjectReference _module;
    private bool _dropdownInitialized = false;
    
    public async Task<List<string>> GetLanguageDataAsync()
    {
        try
        {
            var selectedText = await JSRuntime.InvokeAsync<string>(
                "eval", 
                "document.getElementById('selectedValues').textContent.trim()"
            );
            
            // TODO: Remove magic string
            if (selectedText == "Select one or more languages")
            {
                return new List<string>();
            }

            // Remove flags, spaces etc.
            var languages = new List<string>();
            var temp = selectedText.Split(',');
            foreach (var l in temp)
            {
                var lang = l.Trim();
                languages.Add(lang.Substring(lang.IndexOf(' ')).Trim());
            }
                
            return languages;
        }
        catch (Exception)
        {
            return new List<string>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./subtitle-lang-select.js");
            await InitializeDropdown();
        }
    }

    private async Task InitializeDropdown()
    {
        if (!_dropdownInitialized && _module != null)
        {
            _dropdownInitialized = await _module.InvokeAsync<bool>("initializeDropdown");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}
